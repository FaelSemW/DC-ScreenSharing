# DCSS.ProfileService Environment Configuration

# Service Listening Port (default: 5000)
PORT=5000

# Strong secret key for administrative endpoints (/api/v1/admin/*)
# Generate a cryptographically random secret string in production
ADMIN_API_KEY=replace-with-a-strong-random-secret-key-32-chars-min

# ASP.NET Core Environment (Development / Production)
ASPNETCORE_ENVIRONMENT=Production
