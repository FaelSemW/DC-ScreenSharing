<Window x:Class="DCSS.ProfileCollector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DCSS.ProfileCollector.ViewModels"
        mc:Ignorable="d"
        Title="DCSS Profile Collector"
        Height="720" Width="980"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DCSS Profile Collector" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Automated WireGuard batch generation and pool organizer for DC-ScreenSharing" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="Provider: VPNBook" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terms Confirmation Box -->
        <Border Grid.Row="1" Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding AcceptConditions, Mode=TwoWay}" VerticalAlignment="Center">
                    <TextBlock Text="I understand and accept the provider's current conditions (each profile is unique, expires in 7 days, and may only be used on one device at a time)." FontSize="12" FontWeight="Medium" Foreground="#854D0E" TextWrapping="Wrap" />
                </CheckBox>
            </Grid>
        </Border>

        <!-- Main Content Area with Tabs -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: Single Region Batch -->
            <TabItem Header="Single Region Batch" FontSize="13" FontWeight="SemiBold" Padding="12,6">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Settings -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Batch Configuration" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />

                                <!-- Region -->
                                <TextBlock Text="Region" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableRegions}" SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,0,12" />

                                <!-- Server Selection Mode -->
                                <TextBlock Text="Server" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ServerModes}" SelectedItem="{Binding SelectedServerMode, Mode=TwoWay}" Margin="0,0,0,12" />

                                <!-- Port -->
                                <TextBlock Text="Port (UDP)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}" Margin="0,0,0,12" />

                                <!-- Quantity -->
                                <TextBlock Text="Quantity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <!-- Output Folder -->
                                <TextBlock Text="Output Folder" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding OutputFolder, Mode=TwoWay}" IsReadOnly="True" />
                                    <Button Grid.Column="2" Content="Browse" Click="OnBrowseOutputFolderClick" Background="#F1F5F9" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" />
                                </Grid>

                                <!-- Resume Helper -->
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,14" Visibility="{Binding CanResume, Converter={x:Static viewModels:BoolToVisibilityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ResumeRecommendationText}" FontSize="11" Foreground="#166534" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <Button Content="Resume Remaining" Click="OnResumeRemainingClick" Background="#DCFCE7" Foreground="#15803D" BorderBrush="#86EFAC" HorizontalAlignment="Left" Padding="10,4" FontSize="11" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Generate Profiles" Click="OnGenerateProfilesClick" IsEnabled="{Binding CanStart}" Background="{StaticResource PrimaryBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,8,0" Padding="18,8" />
                                    <Button Content="Cancel Batch" Click="OnCancelBatchClick" IsEnabled="{Binding IsGenerating}" Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right Column: Live Progress & Results -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Progress Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Batch Progress" FontSize="14" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>

                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Height="8" Margin="0,0,0,12" Foreground="{StaticResource PrimaryBrush}" Background="#E2E8F0" BorderThickness="0" />

                            <!-- Results DataGrid -->
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="140" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="130" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                    <DataGridTextColumn Header="Expiration" Binding="{Binding ExpirationDisplay}" Width="130" />
                                    <DataGridTextColumn Header="Identity Hash" Binding="{Binding DerivedPublicKeyHash}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Summary Card on completion -->
                            <Border Grid.Row="3" Margin="0,12,0,0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12" Visibility="{Binding ShowSummary, Converter={x:Static viewModels:BoolToVisibilityConverter.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Batch Summary" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SummaryRequested, StringFormat='Requested: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SummaryValid, StringFormat='Valid: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" />
                                        <TextBlock Text="{Binding SummaryDuplicates, StringFormat='Duplicates: {0}'}" FontSize="11" Foreground="#B45309" />
                                        <TextBlock Text="{Binding SummaryFailed, StringFormat='Failed: {0}'}" FontSize="11" Foreground="#B91C1C" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Content="Open Folder" Click="OnOpenFolderClick" Background="#F1F5F9" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" Margin="0,0,8,0" Padding="10,6" FontSize="11" />
                                        <Button Content="Import into Maintainer" Click="OnImportIntoMaintainerClick" Background="{StaticResource PrimaryBrush}" Foreground="#FFFFFF" BorderThickness="0" Padding="12,6" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Multi-Region Job -->
            <TabItem Header="Multi-Region Job" FontSize="13" FontWeight="SemiBold" Padding="12,6">
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Multi-Region Batch Plan" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Processes regions sequentially and creates organized configs in configs/US, configs/CA, etc." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding MultiRegionPlan}" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" HeadersVisibility="Column" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Region Code" Binding="{Binding RegionCode}" IsReadOnly="True" Width="100" />
                                <DataGridTextColumn Header="Region Name" Binding="{Binding DisplayName}" IsReadOnly="True" Width="180" />
                                <DataGridTextColumn Header="Target Quantity" Binding="{Binding Quantity, Mode=TwoWay}" Width="130" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Generate All Regions" Click="OnGenerateAllRegionsClick" IsEnabled="{Binding CanStart}" Background="{StaticResource PrimaryBrush}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,8,0" Padding="18,8" />
                            <Button Content="Cancel Job" Click="OnCancelBatchClick" IsEnabled="{Binding IsGenerating}" Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="DCSS.ProfileCollector v1.0.1" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
